    "Assessability": {
      "additionalProperties": false,
      "properties": {
        "score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "status": {
          "$ref": "#/$defs/AssessabilityStatus"
        },
        "face_detected_ratio": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Face Detected Ratio"
        },
        "factors": {
          "items": {
            "$ref": "#/$defs/AssessabilityFactor"
