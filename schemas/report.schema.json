      "title": "AssessabilityStatus",
      "type": "string"
    },
    "CalibratedProbability": {
      "additionalProperties": false,
      "description": "只在声明的评测分布与阈值下成立的校准概率，不是事实确定性。",
      "properties": {
        "value": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "is_calibrated": {
          "default": false,
          "title": "Is Calibrated",
          "type": "boolean"
        },
        "calibration_version": {
          "default": "unknown",
          "title": "Calibration Version",
          "type": "string"
        },
        "calibration_group": {
          "default": "unknown",
          "title": "Calibration Group",
          "type": "string"
        },
        "distribution": {
          "default": "未声明的评测分布",
          "title": "Distribution",
          "type": "string"
        },
        "confidence_interval": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence Interval"
        },
        "semantics": {
          "default": "该数值只表示在声明的评测分布和阈值下的生成合成风险，不代表事实确定性。",
          "title": "Semantics",
          "type": "string"
        }
      },
      "title": "CalibratedProbability",
      "type": "object"
    },
