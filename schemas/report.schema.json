          "title": "Value"
        },
        "status": {
          "enum": [
            "good",
            "warning",
            "bad",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value",
        "status",
        "explanation"
      ],
      "title": "AssessabilityFactor",
      "type": "object"
    },
