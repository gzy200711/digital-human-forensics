APP_ENV=development
APP_NAME=数字人鉴别平台
APP_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
SECRET_KEY=change-me

DATABASE_URL=sqlite+aiosqlite:///./data/forensics.db
QUEUE_BACKEND=inline
REDIS_URL=redis://localhost:6379/0

STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=./data/derived/object-store
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=forensics
S3_REGION=us-east-1

MAX_UPLOAD_BYTES=524288000
ALLOWED_MEDIA_TYPES=video/mp4,video/quicktime,video/x-matroska,video/webm,video/x-msvideo,video/avi,video/x-m4v,audio/wav,audio/x-wav,audio/wave,audio/mpeg,audio/mp4,audio/aac,audio/flac
RAW_RETENTION_DAYS=7
RETENTION_SWEEP_INTERVAL_SECONDS=3600
ALLOW_PRIVATE_URLS=false
URL_DOWNLOAD_TIMEOUT_SECONDS=45
MAX_MEDIA_DURATION_SECONDS=900

SAMPLE_FPS=2.0
TEMPORAL_FPS=4.0
MAX_SAMPLED_FRAMES=600
QUALITY_PASS_THRESHOLD=0.62
QUALITY_MARGINAL_THRESHOLD=0.42

CALIBRATION_PATH=configs/calibration.json
FUSION_CONFIG_PATH=configs/fusion.json
VISUAL_ONNX_PATH=
ONNX_INPUT_SIZE=224
VISUAL_ONNX_LICENSE=Apache-2.0
VISUAL_ONNX_SOURCE=dima806/deepfake_vs_real_image_detection

AUDIO_SPOOF_ONNX_PATH=
AUDIO_SPOOF_INPUT_MODE=waveform
AUDIO_SPOOF_SAMPLE_RATE=16000
AUDIO_SPOOF_SEGMENT_SECONDS=4.04
AUDIO_SPOOF_MAX_SEGMENTS=8
AUDIO_SPOOF_AGGREGATION=max
AUDIO_SPOOF_LICENSE=MIT
AUDIO_SPOOF_SOURCE=AASIST

REVIEW_PROVIDER_MODE=rules
REVIEW_PROVIDER_ENDPOINT=
REVIEW_PROVIDER_API_KEY=
REVIEW_PROVIDER_MODEL=
REVIEW_PROVIDER_TIMEOUT_SECONDS=20
REVIEW_PROMPT_VERSION=evidence-review-v1
REVIEW_PROVIDER_LICENSE=

# 隐式水印核验（SynthID Detector / 联盟水印核验服务）。
# auto：按已填写的凭据自动选择 synthid 或 alliance；也可显式填 synthid / alliance / off。
WATERMARK_PROVIDER=auto
WATERMARK_PROVIDER_LABEL=
WATERMARK_ENDPOINT=
WATERMARK_API_KEY=
WATERMARK_APP_ID=
WATERMARK_SECRET=
WATERMARK_MEDIA_FIELD=file
WATERMARK_EXTRA_FIELDS={}
WATERMARK_AUTH_HEADER=Authorization
WATERMARK_AUTH_SCHEME=Bearer
WATERMARK_SIGN_REQUESTS=true
WATERMARK_VERIFY_TLS=true
WATERMARK_TIMEOUT_SECONDS=30
# 默认 false：不把原始媒体上传给外部核验服务；开启前请确认素材授权与数据出境要求。
WATERMARK_ALLOW_MEDIA_UPLOAD=false

CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# 公网访问密码。仅对 Cloudflare Tunnel 等非私网来源生效。
PUBLIC_ACCESS_USER=dhfp
PUBLIC_ACCESS_PASSWORD=change-this-before-public-exposure

# ONNX 检测模型（可选）：按 README「ONNX 视觉模型 / 音频反欺骗」章节导出后启用。
# 未配置时运行时使用内置启发式基线（弱信号）。
VISUAL_ONNX_PATH=
AUDIO_SPOOF_ONNX_PATH=
AUDIO_SPOOF_INPUT_MODE=waveform
AUDIO_SPOOF_AGGREGATION=max
# 与导出模型的固定输入长度一致（AASIST 默认 64600 样本 / 16000 Hz）。
AUDIO_SPOOF_SEGMENT_SECONDS=4.0375
